---
interface Props {
  slug: string;
  className?: string;
}
const { slug, className = "w-10 h-10" } = Astro.props;

// Thin-line medical/clinical icons (24×24 viewBox, stroke 1.6, round caps)
// Consistent with the Clean Clinical design system + OCT hero.
const icons: Record<string, string> = {
  'eye-anatomy-basics': `
    <path d="M2 12C5.5 6.5 18.5 6.5 22 12C18.5 17.5 5.5 17.5 2 12Z"/>
    <circle cx="12" cy="12" r="3.2"/>
    <circle cx="12" cy="12" r="1.1" fill="currentColor" stroke="none"/>
  `,
  'sudden-floater-emergency': `
    <path d="M12 3.5L21.5 19.5H2.5L12 3.5Z"/>
    <path d="M12 9.5V13"/>
    <circle cx="12" cy="16" r="0.9" fill="currentColor" stroke="none"/>
  `,
  'pvd-survival-guide': `
    <path d="M2.5 5.5C5.5 4 8.5 4.2 12 6C15.5 4.2 18.5 4 21.5 5.5V18.5C18.5 17 15.5 17.2 12 19C8.5 17.2 5.5 17 2.5 18.5V5.5Z"/>
    <path d="M12 6V19"/>
  `,
  'screen-setup-floaters': `
    <rect x="3.5" y="4.5" width="17" height="11.5" rx="1.5"/>
    <path d="M9 20H15"/>
    <path d="M8 20V19.5C8 18.7 8.5 18 9.2 18H14.8C15.5 18 16 18.7 16 19.5V20"/>
    <path d="M8 8H10.5M13.5 8H16"/>
  `,
  'sunglasses-floaters': `
    <rect x="3" y="8.5" width="7" height="6" rx="2.2"/>
    <rect x="14" y="8.5" width="7" height="6" rx="2.2"/>
    <path d="M10 10.5H14"/>
    <path d="M3 10L1.2 7.5M21 10L22.8 7.5"/>
    <path d="M5 14.5V17M8 14.5V17M16 14.5V17M19 14.5V17"/>
  `,
  'floater-supplements-evidence': `
    <rect x="7" y="3.5" width="10" height="17" rx="5"/>
    <path d="M12 3.5V20.5"/>
    <path d="M7 8.5H10.5M7 12H9.5"/>
  `,
  'supplement-quality': `
    <circle cx="10" cy="10" r="6"/>
    <path d="M14.5 14.5L21 21"/>
    <rect x="7.5" y="8.5" width="5" height="3" rx="1.5"/>
  `,
  'treatments-watching': `
    <path d="M10 3.5H14"/>
    <path d="M11 3.5V8"/>
    <path d="M6.5 8H17.5"/>
    <path d="M7 8L5.6 15.4C5.3 16.9 6.5 18.2 8 18.2H16C17.5 18.2 18.7 16.9 18.4 15.4L17 8"/>
    <circle cx="10" cy="13" r="0.8" fill="currentColor" stroke="none"/>
    <circle cx="13.5" cy="15.5" r="0.8" fill="currentColor" stroke="none"/>
  `,
  'when-to-see-doctor': `
    <path d="M6 3.5V7.5A6 6 0 0 0 12 13.5A6 6 0 0 0 18 7.5V3.5"/>
    <path d="M6 5H8M16 5H18"/>
    <path d="M12 13.5V16.5"/>
    <circle cx="12" cy="18.8" r="2.2"/>
  `,
};
---

{
  icons[slug] ? (
    <div
      class={`flex items-center justify-center rounded-xl bg-sage/10 text-sage shrink-0 ${className}`}
      aria-hidden="true"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="w-1/2 h-1/2"
        set:html={icons[slug]}
      />
    </div>
  ) : (
    <div class={`bg-sage/10 rounded-xl ${className}`} aria-hidden="true" />
  )
}
