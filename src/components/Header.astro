---
import { type HTMLAttributes } from 'astro';
interface Props extends HTMLAttributes<'header'> {
  currentPath?: string;
}
const { currentPath = '/', ...attrs } = Astro.props;
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/conditions/floaters', label: 'Floaters' },
  { href: '/conditions/macular', label: 'Macular Health' },
  { href: '/conditions/discomfort', label: 'Eye Discomfort' },
  { href: '/guides', label: 'Guides' },
  { href: '/about', label: 'About' },
];
---

<header {...attrs} class="sticky top-0 z-50 bg-cream/95 backdrop-blur-sm border-b border-border">
  <nav class="container" aria-label="Main navigation">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 py-4">
      <div class="flex items-center justify-between">
        <a href="/" class="flex items-center gap-3">
          <svg class="w-8 h-8 text-primary" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M2 12h2M20 12h2" />
          </svg>
          <span class="font-bold text-2xl text-charcoal">Floaters Focus</span>
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-button"
          type="button"
          class="md:hidden p-2 -mr-2 text-charcoal hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-gold rounded-md"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path id="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Mobile navigation -->
      <ul
        id="mobile-menu"
        class="hidden md:flex md:flex-row md:flex-wrap md:justify-center gap-2 md:gap-4"
        role="menubar"
      >
        {navItems.map(item => (
          <li role="none">
            <a
              href={item.href}
              role="menuitem"
              class={`px-4 py-2 rounded-md font-medium transition-colors ${currentPath === item.href ? 'bg-primary text-cream' : 'text-text hover:bg-bg-alt'}`}
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <script is:inline>
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    const openIcon = document.getElementById('menu-icon-open');
    const closeIcon = document.getElementById('menu-icon-close');

    if (button && menu) {
      button.addEventListener('click', () => {
        const isOpen = !menu.classList.contains('hidden');
        menu.classList.toggle('hidden');
        button.setAttribute('aria-expanded', String(!isOpen));
        if (openIcon && closeIcon) {
          openIcon.classList.toggle('hidden');
          closeIcon.classList.toggle('hidden');
        }
      });
    }
  </script>
</header>
