---
import { type HTMLAttributes } from 'astro';
interface Props extends HTMLAttributes<'header'> {
  currentPath?: string;
}
const { currentPath = '/', ...attrs } = Astro.props;
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/conditions/floaters', label: 'Floaters' },
  { href: '/conditions/macular', label: 'Macular Health' },
  { href: '/conditions/discomfort', label: 'Eye Discomfort' },
  { href: '/guides', label: 'Guides' },
  { href: '/products', label: 'Products' },
  { href: '/about', label: 'About' },
  { href: '/citations', label: 'Citations' },
];
---

<header {...attrs} class="bg-white/90 backdrop-blur-sm border-b border-gray-200 sticky top-0 z-50">
  <nav class="container mx-auto px-4" aria-label="Main navigation">
    <div class="flex items-center justify-between min-h-16">
      <a href="/" class="flex items-center gap-2.5">
        <svg class="w-7 h-7 text-sage" aria-hidden="true" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <!-- Hand-drawn eye: almond outline with a second stroke for the wobble of a real pen -->
          <path d="M3.5 18c4.3-6.7 9.6-9.8 12.6-9.8S27.6 11.3 32.5 18c-4.9 6.7-10.1 9.8-13.1 9.8S7.8 24.7 3.5 18Z" />
          <path d="M6.2 18.4c4-6 8.6-8.9 10.9-9" opacity="0.45" />
          <!-- Iris -->
          <circle cx="18" cy="18" r="5.6" fill="currentColor" stroke="none" opacity="0.92" />
          <!-- The floater, drawn in the light of the iris -->
          <path d="M16 16.2c.8-.7 1.8-.1 2.3 1 .5 1.1 1.5 1.8 2.5 1.2" stroke="#ffffff" stroke-width="1.6" opacity="0.95" fill="none" />
        </svg>
        <span class="font-semibold text-lg text-charcoal tracking-tight">Floaters Focus</span>
      </a>

      <div class="flex items-center gap-1">
        <button
          id="theme-toggle"
          type="button"
          class="p-2 -mr-2 text-charcoal hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-gold rounded-md"
          aria-label="Toggle dark mode"
          title="Toggle dark mode"
        >
          <svg id="theme-icon-sun" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="5" />
            <path stroke-linecap="round" d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
          </svg>
          <svg id="theme-icon-moon" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>

        <div class="relative" id="text-size-wrap">
          <button
            id="text-size-button"
            type="button"
            class="p-2 -mr-1 text-charcoal hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-gold rounded-md flex items-center gap-1"
            aria-label="Text size"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="text-size-menu"
            title="Text size"
          >
            <span class="text-lg leading-none font-semibold" aria-hidden="true">A</span>
            <svg class="w-3 h-3 text-warm-gray" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div
            id="text-size-menu"
            class="hidden absolute right-0 top-full mt-2 z-50 w-44 rounded-lg border border-gray-200 bg-white shadow-md p-1"
            aria-label="Text size"
          >
            <button data-size="" aria-pressed="false" class="block w-full text-left px-3 py-2 rounded-md text-sm font-medium text-charcoal hover:bg-gray-100">A · Normal</button>
            <button data-size="lg" aria-pressed="false" class="block w-full text-left px-3 py-2 rounded-md text-base font-medium text-charcoal hover:bg-gray-100">A+ · Large</button>
            <button data-size="xl" aria-pressed="false" class="block w-full text-left px-3 py-2 rounded-md text-lg font-medium text-charcoal hover:bg-gray-100">A++ · Larger</button>
            <button data-size="xxl" aria-pressed="false" class="block w-full text-left px-3 py-2 rounded-md text-xl font-medium text-charcoal hover:bg-gray-100">A+++ · Largest</button>
          </div>
        </div>

        <button
          id="mobile-menu-button"
          type="button"
          class="md:hidden p-2 -mr-2 text-charcoal hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-gold rounded-md"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path id="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <ul
        id="mobile-menu"
        class="hidden md:flex md:flex-wrap md:items-center gap-1"
        role="menubar"
      >
        {navItems.map(item => (
          <li role="none">
            <a
              href={item.href}
              role="menuitem"
              class={`px-3 py-2 rounded-md text-sm font-medium transition-colors ${currentPath === item.href ? 'bg-sage/10 text-sage' : 'text-charcoal hover:bg-gray-100'}`}
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Mobile dropdown -->
    <div id="mobile-menu-panel" class="hidden md:hidden pb-3">
      <ul class="flex flex-col gap-1" role="menubar">
        {navItems.map(item => (
          <li role="none">
            <a
              href={item.href}
              role="menuitem"
              class={`block px-3 py-2 rounded-md text-sm font-medium transition-colors ${currentPath === item.href ? 'bg-sage/10 text-sage' : 'text-charcoal hover:bg-gray-100'}`}
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <script is:inline>
    (function() {
      const button = document.getElementById('mobile-menu-button');
      const panel = document.getElementById('mobile-menu-panel');
      const openIcon = document.getElementById('menu-icon-open');
      const closeIcon = document.getElementById('menu-icon-close');

      if (button && panel) {
        button.addEventListener('click', () => {
          const isOpen = !panel.classList.contains('hidden');
          panel.classList.toggle('hidden');
          button.setAttribute('aria-expanded', String(!isOpen));
          if (openIcon && closeIcon) {
            openIcon.classList.toggle('hidden');
            closeIcon.classList.toggle('hidden');
          }
        });
      }

      const themeButton = document.getElementById('theme-toggle');
      const sunIcon = document.getElementById('theme-icon-sun');
      const moonIcon = document.getElementById('theme-icon-moon');
      const themeKey = 'floatersfocus-theme-v2';

      const updateThemeUI = (theme) => {
        if (!sunIcon || !moonIcon) return;
        if (theme === 'dark') {
          sunIcon.classList.remove('hidden');
          moonIcon.classList.add('hidden');
        } else {
          sunIcon.classList.add('hidden');
          moonIcon.classList.remove('hidden');
        }
      };

      const current = document.documentElement.getAttribute('data-theme') || 'light';
      updateThemeUI(current);

      if (themeButton) {
        themeButton.addEventListener('click', () => {
          const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          localStorage.setItem(themeKey, next);
          updateThemeUI(next);
        });
      }

      // ---- Text size control (low-vision readers, 2026-08-28) ----
      const sizeButton = document.getElementById('text-size-button');
      const sizeMenu = document.getElementById('text-size-menu');
      const sizeWrap = document.getElementById('text-size-wrap');
      const sizeKey = 'floatersfocus-text-size';
      const sizeLabels = { '': 'Normal', lg: 'Large', xl: 'Larger', xxl: 'Largest' };

      const currentSize = () => document.documentElement.getAttribute('data-text-size') || '';

      const updateSizeUI = () => {
        const cur = currentSize();
        const items = sizeMenu ? sizeMenu.querySelectorAll('[data-size]') : [];
        items.forEach((it) => {
          const on = (it.getAttribute('data-size') || '') === cur;
          it.setAttribute('aria-pressed', String(on));
          it.classList.toggle('bg-sage/10', on);
          it.classList.toggle('text-sage', on);
        });
        if (sizeButton) {
          sizeButton.setAttribute('aria-label', `Text size: ${sizeLabels[cur]}. Choose a size.`);
        }
      };

      const setSize = (size) => {
        document.documentElement.setAttribute('data-text-size', size || '');
        if (size) localStorage.setItem(sizeKey, size);
        else localStorage.removeItem(sizeKey);
        updateSizeUI();
      };

      if (sizeButton && sizeMenu) {
        sizeButton.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = !sizeMenu.classList.contains('hidden');
          sizeMenu.classList.toggle('hidden', isOpen);
          sizeButton.setAttribute('aria-expanded', String(!isOpen));
        });
        sizeMenu.addEventListener('click', (e) => {
          const btn = e.target.closest('[data-size]');
          if (!btn) return;
          setSize(btn.getAttribute('data-size') || '');
          sizeMenu.classList.add('hidden');
          sizeButton.setAttribute('aria-expanded', 'false');
        });
        document.addEventListener('click', (e) => {
          if (sizeWrap && !sizeWrap.contains(e.target)) {
            sizeMenu.classList.add('hidden');
            sizeButton.setAttribute('aria-expanded', 'false');
          }
        });
        updateSizeUI();
      }
    })();
  </script>
</header>
