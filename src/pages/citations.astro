<BaseLayout title="Citations & Studies" description="The research behind our evidence-backed guidance: DOIs, PubMed IDs, and key trials for floaters, macular health, dry eye, and supplements." publishedDate="2026-08-08" lastReviewed="2026-08-08">
  <Header currentPath="/citations" slot="header" />
  <Footer slot="footer" />

  <section class="py-12 md:py-20" aria-labelledby="citations-title">
    <div class="container max-w-3xl">
      <header class="mb-12">
        <h1 id="citations-title" class="text-3xl md:text-4xl font-bold text-charcoal mb-4">
          Citations & Studies
        </h1>
        <p class="text-lg text-text leading-relaxed">
          We link to the actual studies so you can verify. If we say "study shows," you can click through and read the abstract yourself.
        </p>
      </header>

      <article class="prose prose-lg prose-charcoal max-w-none space-y-10">
        <section>
          <h2 class="text-2xl font-bold text-charcoal mb-4">Macular Health / AMD</h2>
          <ul class="space-y-2 text-text" role="list">
            <li>Age-Related Eye Disease Study 2 (AREDS2) Research Group. <em>JAMA</em> 2013;309(19):2005-2015. doi: <a href="https://doi.org/10.1001/jama.2013.4997" target="_blank" rel="noopener">10.1001/jama.2013.4997</a></li>
          </ul>
        </section>

