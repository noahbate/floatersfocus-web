---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import conditionsData from '../../data/conditions.json';
import productsData from '../../data/products.json';

interface Props {
  condition: any;
  products: any[];
}
const { condition, products } = Astro.props;
const pageTitle = `${condition.name} — Floaters Focus`;
const pageDescription = condition.description;
const conditionReviewed = condition.date_reviewed || condition.date_modified || "2026-08-08";

// Generate static paths for each condition
export async function getStaticPaths() {
  const conditions = conditionsData.conditions || [];
  const allProducts = productsData.products || [];

  return conditions.map((condition: any) => ({
    params: { slug: condition.slug },
    props: {
      condition,
      products: allProducts.filter((p: any) => (p.condition_ids || []).includes(condition.id))
    }
  }));
}
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedDate="2026-08-08"
  lastReviewed={conditionReviewed}
>
  <Header currentPath={`/conditions/${condition.slug}`} slot="header" />
  <Footer slot="footer" />

  <!-- Hero -->
  <section class="bg-white border-b border-gray-200 py-12 md:py-16" aria-labelledby="condition-title">
    <div class="container">
      <nav class="mb-6 text-sm" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-warm-gray" role="list">
          <li><a href="/" class="hover:text-primary">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/conditions" class="hover:text-primary">Conditions</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-charcoal font-medium" aria-current="page">{condition.name}</li>
        </ol>
      </nav>

      <header class="max-w-3xl mx-auto text-center mb-12">
        <h1 id="condition-title" class="text-3xl md:text-4xl lg:text-5xl font-bold text-charcoal mb-4">
          {condition.name}
        </h1>
        <p class="text-lg md:text-xl text-text leading-relaxed">
          {condition.description}
        </p>
      </header>
    </div>
  </section>

  <!-- Red Flags Banner -->
  {condition.red_flags && condition.red_flags.length > 0 && (
    <section class="bg-red/5 border-y border-red/30 py-4" aria-labelledby="red-flags-heading" role="alert">
      <div class="container">
        <h2 id="red-flags-heading" class="visually-hidden">Red Flags — Seek Care Immediately</h2>
        <ul class="flex flex-col md:flex-row gap-4 md:gap-6 justify-center" role="list">
          {condition.red_flags.map(flag => (
            <li class="flex items-center gap-2 text-red font-medium text-sm">
              <svg class="w-5 h-5 flex-shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-10 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
              </svg>
              {flag}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Key Points -->
  <section class="py-12 md:py-16" aria-labelledby="keypoints-heading">
    <div class="container">
      <header class="text-center mb-10">
        <h2 id="keypoints-heading" class="text-2xl md:text-3xl font-bold text-charcoal mb-3">
          What You Need to Know
        </h2>
        <p class="text-text max-w-2xl mx-auto">
          The essential facts before we get into treatments.
        </p>
      </header>

      <div class="grid gap-4 grid-cols-1 lg:grid-cols-2 xl:grid-cols-4 max-w-5xl mx-auto">
        {condition.key_points.map((point, i) => (
          <article class="card card-bordered group">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 bg-blue/10 rounded-lg flex items-center justify-center flex-shrink-0 group-hover:bg-blue/20 transition-colors">
                <span class="text-blue font-bold text-lg">{i + 1}</span>
              </div>
              <p class="text-text leading-relaxed">{point}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Evidence-Based Treatments -->
  <section class="py-12 md:py-16 bg-warm-white" aria-labelledby="treatments-heading">
    <div class="container">
      <header class="text-center mb-10">
        <h2 id="treatments-heading" class="text-2xl md:text-3xl font-bold text-charcoal mb-3">
          What Actually Works (Evidence-Based)
        </h2>
        <p class="text-text max-w-2xl mx-auto">
          These treatments have RCT data or major society guideline backing (AAO, TFOS, AREDS).
        </p>
      </header>

      <div class="max-w-3xl mx-auto space-y-4">
        {condition.evidence_based_treatments.map((treatment, i) => (
          <article class="card card-bordered">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-green/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <span class="text-green font-bold text-lg">{i + 1}</span>
              </div>
              <div class="text-text leading-relaxed">{treatment}</div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Product Recommendations -->
  {products && products.length > 0 && (
    <section class="py-12 md:py-16" aria-labelledby="products-heading">
      <div class="container">
        <header class="text-center mb-10">
          <h2 id="products-heading" class="text-2xl md:text-3xl font-bold text-charcoal mb-3">
            Products with Data Behind Them
          </h2>
          <p class="text-text max-w-2xl mx-auto">
            These match the treatments above. We only list products with clinical evidence for their ingredients.
            Affiliate links support the site at no cost to you.
          </p>
        </header>

        <div class="grid gap-6 grid-cols-1 md:grid-cols-2 xl:grid-cols-3 max-w-5xl mx-auto">
          {products.map(product => (
            <article class="card card-bordered">
              <div class="flex items-start justify-between mb-4">
                <span class={`text-sm px-3 py-1 rounded-full font-medium ${
                  product.category === 'supplement' ? 'bg-blue/10 text-blue' :
                  product.category === 'omega-3' ? 'bg-amber/10 text-amber' :
                  product.category === 'artificial-tear' ? 'bg-green/10 text-green' :
                  'bg-teal/10 text-teal'
                }`}>
                  {product.category.replace('-', ' ')}
                </span>
                <div class="flex items-center gap-1" aria-label={`${product.rating_avg} out of 5 stars`}>
                  <span class="text-gold">{'★'.repeat(Math.floor(product.rating_avg))}{'☆'.repeat(5 - Math.floor(product.rating_avg))}</span>
                  <span class="text-warm-gray text-sm">({product.review_count.toLocaleString()})</span>
                </div>
              </div>

              <h3 class="text-xl font-bold text-charcoal mb-2">{product.name}</h3>
              <p class="text-text mb-4 text-sm">{product.evidence} {product.evidence_url && (<a href={product.evidence_url} target="_blank" rel="noopener" class="text-primary hover:underline ml-1">[View study]</a>)}</p>

              <div class="flex items-baseline gap-2 mb-4">
                <span class="text-2xl font-bold text-charcoal">${product.price_usd.toFixed(2)}</span>
                <span class="text-warm-gray text-sm">/ {product.servings_per_container} {product.serving_size.includes('softgel') || product.serving_size.includes('tablet') ? 'softgels' : 'servings'}</span>
              </div>

              <dl class="space-y-2 text-sm text-text mb-6">
                <div class="flex justify-between">
                  <dt class="text-warm-gray">Serving:</dt>
                  <dd class="font-medium">{product.serving_size}</dd>
                </div>
                <div class="flex justify-between">
                  <dt class="text-warm-gray">Key:</dt>
                  <dd class="font-medium text-charcoal">
                    {Object.entries(product.key_ingredients).slice(0, 3).map(([k, v]) => `${k} ${v}`).join(', ')}
                    {Object.keys(product.key_ingredients).length > 3 && '...'}
                  </dd>
                </div>
              </dl>

              <div class="space-y-2 mb-6">
                <h4 class="font-semibold text-charcoal flex items-center gap-1">
                  <svg class="w-4 h-4 text-green" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
                  Pros
                </h4>
                <ul class="space-y-1 pl-5 list-disc" role="list">
                  {product.pros.slice(0, 3).map(pro => (
                    <li class="text-sm text-text">{pro}</li>
                  ))}
                </ul>

                <h4 class="font-semibold text-charcoal flex items-center gap-1">
                  <svg class="w-4 h-4 text-red" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
                  Cons
                </h4>
                <ul class="space-y-1 pl-5 list-disc" role="list">
                  {product.cons.slice(0, 3).map(con => (
                    <li class="text-sm text-text">{con}</li>
                  ))}
                </ul>
              </div>

              <a
                href={product.affiliate_urls.amazon || Object.values(product.affiliate_urls)[0]}
                class="btn btn-primary w-full"
                rel="noopener sponsored"
                target="_blank"
                aria-label={`View ${product.name} on Amazon (affiliate link)`}
              >
                Check Price
              </a>
              <p class="text-xs text-warm-gray text-center mt-2">Affiliate link — we may earn a commission</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Adjunctive Options -->
  {condition.adjunctive_supplements && condition.adjunctive_supplements.length > 0 && (
    <section class="py-12 md:py-16 bg-white" aria-labelledby="adjunctive-heading">
      <div class="container">
        <header class="text-center mb-10">
          <h2 id="adjunctive-heading" class="text-2xl md:text-3xl font-bold text-charcoal mb-3">
            Low-Risk Adjunctive Options
          </h2>
          <p class="text-text max-w-2xl mx-auto">
            These oral/topical interventions have early human data for symptomatic floater relief.
            They are investigational, not FDA-approved for floaters, and not replacements for observation or procedures.
          </p>
        </header>

        <div class="max-w-3xl mx-auto space-y-6">
          {condition.adjunctive_supplements.map((item, i) => (
            <article class="card card-bordered">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-teal/10 rounded-lg flex items-center justify-center flex-shrink-0">
                  <span class="text-teal font-bold text-lg">{i + 1}</span>
                </div>
                <div class="text-text leading-relaxed">
                  <h3 class="text-xl font-semibold text-charcoal mb-2">{item.name}</h3>
                  <p class="text-sm mb-2"><strong>Protocol:</strong> {item.protocol}</p>
                  <p class="text-sm mb-2"><strong>Evidence:</strong> {item.evidence}</p>
                  <p class="text-sm"><strong>Closest match:</strong> {item.commercial_match}</p>
                </div>
              </div>
            </article>
          ))}
          {condition.adjunctive_notes && (
            <p class="text-sm text-text-muted bg-cream border border-border rounded-lg p-4">{condition.adjunctive_notes}</p>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- What Doesn't Work -->
  <section class="py-12 md:py-16 bg-red/5" aria-labelledby="myths-heading">
    <div class="container">
      <header class="text-center mb-10">
        <h2 id="myths-heading" class="text-2xl md:text-3xl font-bold text-charcoal mb-3">
          What Doesn't Work (Save Your Money)
        </h2>
        <p class="text-text max-w-2xl mx-auto">
          Popular claims with zero credible evidence. We debunk them so you don't waste time or money.
        </p>
      </header>

      <div class="grid gap-4 grid-cols-1 lg:grid-cols-2 max-w-5xl mx-auto">
        {condition.what_doesnt_work.map((myth, i) => (
          <article class="card card-bordered border-red/20">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 bg-red/10 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-red" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                </svg>
              </div>
              <p class="text-text leading-relaxed">{myth}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- When to See a Doctor -->
  <section class="py-12 md:py-16" aria-labelledby="doctor-heading">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <header class="text-center mb-8">
          <h2 id="doctor-heading" class="text-2xl md:text-3xl font-bold text-charcoal mb-3">
            When to See an Eye Doctor
          </h2>
        </header>

        <div class="card card-bordered bg-amber/5 border-amber/30">
          <div class="p-6">
            <p class="text-text leading-relaxed whitespace-pre-line">{condition.when_to_see_doctor}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Guides -->
  <section class="py-12 md:py-16 bg-warm-white" aria-labelledby="guides-heading">
    <div class="container">
      <header class="text-center mb-10">
        <h2 id="guides-heading" class="text-2xl md:text-3xl font-bold text-charcoal mb-3">
          Helpful Guides
        </h2>
      </header>

      <div class="grid gap-6 md:grid-cols-3 max-w-4xl mx-auto">
        <a href="/guides/supplement-quality" class="card card-bordered group">
          <h3 class="text-xl font-bold text-charcoal mb-2 group-hover:text-primary transition-colors">
            How to Read a Supplement Label
          </h3>
          <p class="text-text">Spot fillers, check forms (rTG vs ethyl ester), verify doses match studies.</p>
        </a>
        <a href="/guides/eye-anatomy-basics" class="card card-bordered group">
          <h3 class="text-xl font-bold text-charcoal mb-2 group-hover:text-primary transition-colors">
            Eye Anatomy 101
          </h3>
          <p class="text-text">Vitreous, macula, meibomian glands—what they are and why they matter.</p>
        </a>
        <a href="/guides/when-to-see-doctor" class="card card-bordered group">
          <h3 class="text-xl font-bold text-charcoal mb-2 group-hover:text-primary transition-colors">
            When to See a Doctor (Full Guide)
          </h3>
          <p class="text-text">Complete red flag list with photos, urgency levels, and what to expect.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Citation + structured data -->
  <section class="py-8 bg-white border-t border-gray-200" aria-labelledby="author-review-heading">
    <div class="container max-w-3xl">
      <h2 id="author-review-heading" class="visually-hidden">Author and Review Information</h2>
      <p class="text-xs text-warm-gray">
        Medical information reviewed by <strong>NP Bate, Ed.S.</strong> • Last reviewed: {conditionReviewed} • Not a substitute for professional care.
      </p>
    </div>
  </section>

  <script type="application/ld+json">
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MedicalWebPage",
      "name": condition.name,
      "description": condition.description,
      "url": `https://floatersfocus.org/conditions/${condition.slug}`,
      "author": {
        "@type": "Person",
        "name": "NP Bate, Ed.S."
      },
      "about": {
        "@type": "MedicalCondition",
        "name": condition.name
      },
      "dateReviewed": conditionReviewed,
      "specialty": "Ophthalmology",
      "inLanguage": "en",
      "publisher": {
        "@type": "Organization",
        "name": "Floaters Focus",
        "url": "https://floatersfocus.org"
      }
    })}
  </script>
</BaseLayout>