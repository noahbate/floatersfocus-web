---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Contact — Floaters Focus" description="Questions, corrections, or press inquiries." publishedDate="2026-08-08" lastReviewed="2026-08-08">
  <Header currentPath="/contact" slot="header" />
  <main class="flex-1">
    <section class="py-12 md:py-16 bg-gradient-to-b from-blue/5 via-cream to-warm-white" aria-labelledby="contact-title">
      <div class="container">
        <header class="max-w-3xl mx-auto text-center mb-12">
          <h1 id="contact-title" class="text-3xl md:text-4xl lg:text-5xl font-bold text-charcoal mb-4">
            Contact
          </h1>
          <p class="text-lg md:text-xl text-text leading-relaxed">
            Questions, corrections, or press inquiries.
          </p>
        </header>
      </div>
    </section>

    <section class="py-12 md:py-16" aria-labelledby="contact-form-heading">
      <div class="container">
        <div class="max-w-xl mx-auto">
          <h2 id="contact-form-heading" class="visually-hidden">Contact Form</h2>
          <form id="contact-form" class="card card-bordered space-y-6">
            <div>
              <label for="name" class="block text-sm font-medium text-charcoal mb-1">Name</label>
              <input type="text" id="name" name="name" required class="w-full rounded-lg border border-border px-4 py-2" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-charcoal mb-1">Email</label>
              <input type="email" id="email" name="email" required class="w-full rounded-lg border border-border px-4 py-2" />
            </div>
            <div>
              <label for="subject" class="block text-sm font-medium text-charcoal mb-1">Subject</label>
              <input type="text" id="subject" name="subject" required class="w-full rounded-lg border border-border px-4 py-2" />
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-charcoal mb-1">Message</label>
              <textarea id="message" name="message" rows="5" required class="w-full rounded-lg border border-border px-4 py-2"></textarea>
            </div>
            <button type="submit" class="btn btn-primary w-full">Send Message</button>
            <p id="contact-status" class="text-sm text-text-muted text-center" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </section>
  </main>
  <Footer slot="footer" />

  <script>
    const form = document.getElementById('contact-form');
    const status = document.getElementById('contact-status');
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      status.textContent = 'Opening your email client...';
      const name = encodeURIComponent(form.name.value.trim());
      const email = encodeURIComponent(form.email.value.trim());
      const subject = encodeURIComponent(form.subject.value.trim());
      const message = encodeURIComponent(form.message.value.trim());
      const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\n\n${message}`);
      const mailto = `mailto:hello@floatersfocus.org?subject=${subject}&body=${body}`;
      window.location.href = mailto;
      status.textContent = 'If your email client did not open, email hello@floatersfocus.org directly.';
    });
  </script>
</BaseLayout>
