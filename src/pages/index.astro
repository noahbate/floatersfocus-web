---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Evidence-Based Eye Health" description="Floaters, PVD, macular health, and dry eye guidance backed by clinical evidence." publishedDate="2026-08-08" lastReviewed="2026-08-08">
  <Header currentPath="/" slot="header" />
  <main class="flex-1">
    <!-- Hero — Clean Clinical, hand-annotated -->
    <section class="bg-white border-b border-gray-200">
      <div class="container mx-auto px-4 py-12 md:py-20">
        <div class="grid gap-10 md:grid-cols-2 items-center">
          <div>
            <p class="font-hand text-xl md:text-2xl text-terracotta -rotate-1 mb-4">field notes on floaters, retinas &amp; dry eyes, since 2020</p>
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-semibold text-charcoal mb-4 tracking-tight leading-tight">
              Eye health that makes sense, no fear, no miracle cures.
            </h1>
            <p class="text-lg text-text mb-6">
              Floaters driving you nuts? Macular degeneration in the family? Eyes feel like sandpaper after screens?
              We translate the research into plain English, so you can make confident choices.
            </p>
            <div class="flex flex-col sm:flex-row gap-3">
              <a href="#conditions" class="btn btn-primary">Explore Conditions</a>
              <a href="/guides/when-to-see-doctor" class="btn btn-secondary">When to See a Doctor</a>
            </div>
            <p class="mt-4 text-sm text-text-muted">I read the studies so you don't have to. Every claim on this site links to the actual paper — <a href="/disclaimer" class="text-primary hover:underline">see our medical disclaimer</a>.</p>
          </div>
          <figure class="hidden md:block relative">
            <img
              src="/images/oct-scan.png"
              alt="Optical coherence tomography (OCT) cross-section scan of a human retina showing its layered structure"
              width="800" height="250" loading="eager"
              class="w-full h-auto rounded-xl border border-gray-200 shadow-lg"
            />
            <!-- Taped handwritten field note pinned to the scan -->
            <div class="absolute bottom-4 left-4 rotate-[-2deg] pen-note px-4 py-2 max-w-[250px]">
              <p class="text-charcoal text-lg leading-snug">field notes: the bright band is your retina. the dark space in front is the gel your floaters drift through.</p>
            </div>
            <figcaption class="text-xs text-text-muted mt-2 text-right font-mono">OCT retinal scan, Image: medOCT-group, Wikimedia Commons (CC BY 2.0)</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Conditions -->
    <section id="conditions" class="py-12 md:py-16 bg-cream">
      <div class="container mx-auto px-4">
        <p class="font-hand text-2xl text-sage -rotate-1 mb-1">start here</p>
        <h2 class="text-2xl md:text-3xl font-semibold text-charcoal mb-8 tracking-tight">What's bothering you?</h2>
        <div class="grid gap-6 grid-cols-1 lg:grid-cols-2 xl:grid-cols-3">
          <!-- Featured card — the one the whole site is about -->
          <article class="card xl:col-span-2 flex flex-col lg:flex-row lg:items-start gap-5">
            <div class="flex-1">
              <h3 class="text-xl font-semibold text-charcoal mb-2 tracking-tight">Floaters &amp; PVD</h3>
              <p class="text-sm text-text-muted mb-3">Posterior vitreous detachment, the usual suspect</p>
              <ul class="space-y-2 text-sm text-text mb-4">
                <li>• Most floaters are benign and fade with time (neuroadaptation)</li>
                <li>• No supplement is FDA-approved for floaters, and efficacy alone does not equal regulatory approval</li>
                <li>• YAG laser works for discrete Weiss rings, not diffuse clouds</li>
                <li class="text-error"><strong>Red flag:</strong> Sudden shower + flashes + curtain = retinal tear (ER now)</li>
              </ul>
              <a href="/conditions/floaters" class="btn btn-primary">Start with floaters</a>
            </div>
            <svg class="hidden lg:block w-28 h-28 shrink-0 self-center text-sage" aria-hidden="true" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <!-- hand-drawn eye with the floater that started this site -->
              <path d="M3.5 18c4.3-6.7 9.6-9.8 12.6-9.8S27.6 11.3 32.5 18c-4.9 6.7-10.1 9.8-13.1 9.8S7.8 24.7 3.5 18Z" />
              <path d="M6.2 18.4c4-6 8.6-8.9 10.9-9" opacity="0.45" />
              <circle cx="18" cy="18" r="5.6" fill="currentColor" stroke="none" opacity="0.92" />
              <path d="M16 16.2c.8-.7 1.8-.1 2.3 1 .5 1.1 1.5 1.8 2.5 1.2" stroke="#ffffff" stroke-width="1.6" opacity="0.95" fill="none" />
            </svg>
          </article>

          <article class="card">
            <h3 class="text-xl font-semibold text-charcoal mb-2 tracking-tight">Macular Health (AMD)</h3>
            <p class="text-sm text-text-muted mb-3">Age-related macular degeneration—early action matters</p>
            <ul class="space-y-2 text-sm text-text mb-4">
              <li>• AREDS2 formula only helps intermediate AMD</li>
              <li>• Does NOT prevent AMD in healthy eyes</li>
              <li>• Smoking = 2–4× risk. Quitting is the best “supplement”</li>
              <li class="text-error"><strong>Red flag:</strong> Wavy lines, new blind spot, sudden blur = wet AMD</li>
            </ul>
            <a href="/conditions/macular" class="text-primary font-medium hover:underline inline-flex items-center gap-1">Read the AMD page →</a>
          </article>

          <article class="card">
            <h3 class="text-xl font-semibold text-charcoal mb-2 tracking-tight">Macular Pucker (ERM)</h3>
            <p class="text-sm text-text-muted mb-3">A membrane wrinkles the macula, wavy, blurred central vision</p>
            <ul class="space-y-2 text-sm text-text mb-4">
              <li>• Often follows a PVD—the gel leaves cells behind that form a membrane</li>
              <li>• Roughly 1 in 11 adults; most cases mild or asymptomatic</li>
              <li>• No drops or exercises remove it—surgery is elective</li>
              <li class="text-error"><strong>Red flag:</strong> Sudden worsening distortion, flashes, or a curtain = call today</li>
            </ul>
            <a href="/conditions/macular-pucker" class="text-primary font-medium hover:underline inline-flex items-center gap-1">The retina membrane →</a>
          </article>

          <article class="card">
            <h3 class="text-xl font-semibold text-charcoal mb-2 tracking-tight">High Eye Pressure (IOP)</h3>
            <p class="text-sm text-text-muted mb-3">Glaucoma suspect—most never develop glaucoma, but IOP is the risk factor you can influence</p>
            <ul class="space-y-2 text-sm text-text mb-4">
              <li>• Caffeine raises IOP acutely, and heavy intake matters most if you're genetically susceptible</li>
              <li>• Drops + laser are the proven protectors; supplements are adjuncts at best</li>
              <li>• B3 (nicotinamide) shows real neuroprotection promise, phase 3 trial running</li>
              <li class="text-error"><strong>Red flag:</strong> Eye pain + nausea + halos = angle closure (ER now)</li>
            </ul>
            <a href="/conditions/high-iop" class="text-primary font-medium hover:underline inline-flex items-center gap-1">Pressure &amp; glaucoma →</a>
          </article>

          <article class="card">
            <h3 class="text-xl font-semibold text-charcoal mb-2 tracking-tight">Dry Eye &amp; Discomfort</h3>
            <p class="text-sm text-text-muted mb-3">Burning, gritty, blurry, especially after screens</p>
            <ul class="space-y-2 text-sm text-text mb-4">
              <li>• 86% is evaporative (MGD)—oil glands clog</li>
              <li>• Trifecta: Lipid tears + Omega-3 rTG + Warm compresses</li>
              <li>• Prescription drops if OTC fails 3 months</li>
              <li class="text-error"><strong>Don't:</strong> Put straight castor oil in eyes</li>
            </ul>
            <a href="/conditions/discomfort" class="text-primary font-medium hover:underline inline-flex items-center gap-1">Dry eye relief →</a>
          </article>
        </div>
      </div>
    </section>

    <!-- Guides / CTA -->
    <section class="py-12 md:py-16 bg-white border-t border-gray-200">
      <div class="container mx-auto px-4">
        <div class="grid gap-8 md:grid-cols-2">
          <div>
            <h2 class="text-2xl font-semibold text-charcoal mb-3 tracking-tight">Practical help, plain English</h2>
            <p class="text-text mb-4">The guides I wish existed when my own PVD showed up uninvited in 2020.</p>
            <ul class="space-y-2 text-sm">
              <li><a href="/guides/supplement-quality" class="text-primary hover:underline">How to read a supplement label</a></li>
              <li><a href="/guides/eye-anatomy-basics" class="text-primary hover:underline">Eye anatomy basics</a></li>
              <li><a href="/guides/when-to-see-doctor" class="text-primary hover:underline">When to see a doctor</a></li>
              <li><a href="/guides/pvd-survival-guide" class="text-primary hover:underline">PVD survival guide</a></li>
              <li><a href="/guides/treatments-watching" class="text-primary hover:underline">Treatments we're watching</a></li>
              <li><a href="/guides/screen-setup-floaters" class="text-primary hover:underline">Screen setup for floaters</a></li>
              <li><a href="/guides/sunglasses-floaters" class="text-primary hover:underline">Sunglasses for floaters</a></li>
            </ul>
          </div>
          <div>
            <h2 class="text-2xl font-semibold text-charcoal mb-3 tracking-tight">Some symptoms can't wait</h2>
            <p class="text-text mb-4">A shower of new floaters, flashes, or a shadow creeping across your vision can mean a torn retina. That's an ER visit, not a Google search.</p>
            <a href="/guides/when-to-see-doctor" class="btn btn-accent">When to See a Doctor</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Free E-Book CTA -->
    <section class="py-12 md:py-16 bg-cream border-t border-gray-200" aria-labelledby="ebook-heading">
      <div class="container mx-auto px-4">
        <div class="card card-bordered max-w-3xl mx-auto p-8 md:p-10 text-center">
          <h2 id="ebook-heading" class="text-2xl md:text-3xl font-bold text-charcoal mb-3">Get the Free E-Book</h2>
          <p class="text-text mb-6 max-w-xl mx-auto">
            Everything on this site in one document, the emergency checklist, the PVD roadmap, the evidence
            on supplements, high eye pressure, and the treatments we're watching. 34 pages, free, with every
            study linked.
          </p>
          <a href="/floaters-focus-ebook.pdf" class="btn btn-primary" download>Download the PDF →</a>
          <p class="mt-4 text-xs text-text-muted">Free edition · floatersfocus.org · share it freely</p>
        </div>
      </div>
    </section>
  </main>
  <Footer slot="footer" />
</BaseLayout>
