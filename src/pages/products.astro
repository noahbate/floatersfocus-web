---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import conditionsData from '../data/conditions.json';
import productsData from '../data/products.json';

const conditions = conditionsData.conditions || [];
const products = productsData.products || [];

// Group products by condition (application), preserving conditions.json order.
// Conditions with no matching products are omitted from the list.
const groups = conditions
  .map(condition => ({
    condition,
    products: products.filter(p => (p.condition_ids || []).includes(condition.id))
  }))
  .filter(group => group.products.length > 0);

const totalProducts = products.length;
const totalGroups = groups.length;
---

<BaseLayout
  title="All Products — Floaters Focus"
  description="Every product we recommend, grouped by the condition it applies to. Only products whose ingredients have clinical evidence."
  publishedDate="2026-08-08"
  lastReviewed="2026-08-08"
>
  <Header currentPath="/products" slot="header" />
  <Footer slot="footer" />

  <!-- Hero -->
  <section class="py-12 md:py-16 bg-white border-b border-gray-200" aria-labelledby="products-title">
    <div class="container">
      <header class="max-w-3xl mx-auto text-center mb-12">
        <h1 id="products-title" class="text-3xl md:text-4xl lg:text-5xl font-bold text-charcoal mb-4">
          All Products
        </h1>
        <p class="text-lg md:text-xl text-text leading-relaxed">
          Every product on this site in one place, grouped by the condition it applies to.
          We only list products whose ingredients have clinical evidence behind them —
          nothing here is a miracle cure, and nothing replaces your eye doctor.
        </p>
        <p class="text-sm text-text-muted mt-4">
          {totalGroups} conditions · {totalProducts} products · Affiliate links support the site at no cost to you.
        </p>
      </header>
    </div>
  </section>

  <!-- Product groups -->
  <section class="py-12 md:py-16" aria-labelledby="product-groups-heading">
    <div class="container">
      <h2 id="product-groups-heading" class="visually-hidden">Products by Application</h2>
      <div class="space-y-16 max-w-6xl mx-auto">
        {groups.map(group => (
          <div aria-labelledby={`group-${group.condition.slug}`}>
            <header class="text-center mb-8">
              <h3 id={`group-${group.condition.slug}`} class="text-2xl md:text-3xl font-bold text-charcoal mb-2">
                {group.condition.name}
              </h3>
              <p class="text-text max-w-2xl mx-auto">
                {group.condition.description}
              </p>
              <a href={`/conditions/${group.condition.slug}`} class="inline-block mt-3 text-sm text-primary hover:underline">
                See the full evidence for {group.condition.name} →
              </a>
            </header>
            <div class="grid gap-6 grid-cols-1 md:grid-cols-2 xl:grid-cols-3">
              {group.products.map(product => (
                <ProductCard product={product} />
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
