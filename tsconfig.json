{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@layouts": ["src/layouts"],
      "@layouts/*": ["src/layouts/*"],
      "@components": ["src/components"],
      "@components/*": ["src/components/*"],
      "@data": ["src/data"],
      "@data/*": ["src/data/*"]
    }
  }
}
